# Drives friring-automations.service on a 1-minute cadence, surviving reboots.
# See friring-automations.service for install instructions.

[Unit]
Description=Fire due friring automations every minute
Documentation=https://github.com/bvc3at/friring

[Timer]
# First run shortly after login, then every minute.
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=15s
Persistent=true

[Install]
WantedBy=timers.target
