{
  "responses": [
    {
      "name": "ambient",
      "ambient": true,
      "match": { "modelContains": "haiku" },
      "reply": { "text": "ok" }
    },
    {
      "name": "activity-write-call",
      "match": { "promptContains": "drift.md", "hasToolResult": false },
      "delayMs": 100,
      "reply": {
        "text": "Writing drift.md now.",
        "toolUse": {
          "id": "toolu_e2e_activity_1",
          "name": "Write",
          "input": {
            "file_path": "{{WS}}/drift.md",
            "content": "capture ring clamped to 92%\n"
          }
        }
      }
    },
    {
      "name": "after-activity-write",
      "match": { "toolResultFor": "toolu_e2e_activity_1" },
      "delayMs": 150,
      "reply": {
        "text": "DRIFT-CONTAINED — clamped the southern ring to 92% and logged it to drift.md. No pause needed."
      }
    }
  ]
}
