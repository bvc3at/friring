{
  "responses": [
    {
      "name": "ambient",
      "ambient": true,
      "match": { "modelContains": "haiku" },
      "reply": { "text": "ok" }
    },
    {
      "name": "activity-write-call",
      "match": { "promptContains": "activity-proof.txt", "hasToolResult": false },
      "delayMs": 100,
      "reply": {
        "text": "Writing activity-proof.txt now.",
        "toolUse": {
          "id": "toolu_e2e_activity_1",
          "name": "Write",
          "input": {
            "file_path": "{{WS}}/activity-proof.txt",
            "content": "activity!\n"
          }
        }
      }
    },
    {
      "name": "after-activity-write",
      "match": { "toolResultFor": "toolu_e2e_activity_1" },
      "delayMs": 150,
      "reply": {
        "text": "ACTIVITY-TURN-DONE — activity-proof.txt was written by a real tool round-trip."
      }
    }
  ]
}
