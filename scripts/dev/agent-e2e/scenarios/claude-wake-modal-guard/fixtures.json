{
  "responses": [
    {
      "name": "ambient",
      "ambient": true,
      "match": { "modelContains": "haiku" },
      "reply": { "text": "ok" }
    },
    {
      "name": "guarded-tool-call",
      "match": { "promptContains": "wake-guard-proof", "hasToolResult": false },
      "delayMs": 100,
      "reply": {
        "text": "Running the wake-guard-proof command now.",
        "toolUse": {
          "id": "toolu_e2e_wake_guard_1",
          "name": "Bash",
          "input": {
            "command": "touch {{WS}}/wake-guard-proof.txt",
            "description": "create the proof file"
          }
        }
      }
    },
    {
      "name": "after-approval",
      "match": { "toolResultFor": "toolu_e2e_wake_guard_1" },
      "delayMs": 150,
      "reply": {
        "text": "WAKE-GUARD-APPROVED — the Bash call ran only after a human answered the dialog."
      }
    },
    {
      "name": "nudge-received",
      "match": { "promptContains": "you have new mail" },
      "delayMs": 100,
      "reply": {
        "text": "WAKE-NUDGE-DELIVERED — the deferred wake was retried once the dialog cleared."
      }
    }
  ]
}
