{
  "responses": [
    {
      "name": "ambient",
      "ambient": true,
      "match": { "modelContains": "haiku" },
      "reply": { "text": "ok" }
    },
    {
      "name": "activity-write",
      "match": { "promptContains": "activity.txt", "hasToolResult": false },
      "delayMs": 100,
      "reply": {
        "text": "Writing activity.txt now.",
        "toolUse": {
          "id": "toolu_e2e_act_w1",
          "name": "Write",
          "input": {
            "file_path": "{{WS}}/activity.txt",
            "content": "Activity view e2e artifact\n"
          }
        }
      }
    },
    {
      "name": "activity-bash",
      "match": { "toolResultFor": "toolu_e2e_act_w1" },
      "delayMs": 100,
      "reply": {
        "text": "Now the marker command.",
        "toolUse": {
          "id": "toolu_e2e_act_b1",
          "name": "Bash",
          "input": {
            "command": "echo ACTIVITY-MARKER",
            "description": "Print the e2e marker"
          }
        }
      }
    },
    {
      "name": "activity-done",
      "match": { "toolResultFor": "toolu_e2e_act_b1" },
      "delayMs": 100,
      "reply": {
        "text": "ACTIVITY-DONE — the turn's Write and Bash actions are on disk for the retrospective."
      }
    }
  ]
}
