{
  "responses": [
    {
      "name": "ambient",
      "ambient": true,
      "match": { "modelContains": "haiku" },
      "reply": { "text": "ok" }
    },
    {
      "name": "write-tool-call",
      "match": { "promptContains": "moon.md", "hasToolResult": false },
      "delayMs": 100,
      "reply": {
        "text": "Flipping the registry flag and writing moon.md now.",
        "toolUse": {
          "id": "toolu_e2e_write_1",
          "name": "Write",
          "input": {
            "file_path": "{{WS}}/moon.md",
            "content": "deprecated = false  # the moon is back\n"
          }
        }
      }
    },
    {
      "name": "after-write",
      "match": { "toolResultFor": "toolu_e2e_write_1" },
      "delayMs": 150,
      "reply": {
        "text": "MOON-RE-ENABLED — moon.md written. Tides recompute on the next pass; nothing downstream needs a redeploy."
      }
    }
  ]
}
