{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "friring-cli session signal --state idle || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "friring-cli session signal --state working || true"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "case \"$(cat)\" in *permission*|*Permission*|*approval*|*approve*) friring-cli session signal --state blocked ;; esac; true"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "friring-cli session signal --state done || true"
          }
        ]
      }
    ]
  }
}
