{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "friring-cli session signal --state idle >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "friring-cli session signal --state working >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "friring-cli session signal --state working >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "friring-cli session signal --state done >/dev/null 2>&1 || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
