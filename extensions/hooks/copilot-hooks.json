{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "friring-cli session signal --state idle || true  # managed by friring `extension install` — do not edit",
        "powershell": "friring-cli session signal --state idle 2>$null; exit 0  # managed by friring `extension install`",
        "timeoutSec": 10
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "bash": "friring-cli session signal --state working || true",
        "powershell": "friring-cli session signal --state working 2>$null; exit 0",
        "timeoutSec": 10
      }
    ],
    "preToolUse": [
      {
        "type": "command",
        "bash": "friring-cli session signal --state working || true",
        "powershell": "friring-cli session signal --state working 2>$null; exit 0",
        "timeoutSec": 10
      }
    ],
    "notification": [
      {
        "type": "command",
        "matcher": "permission_prompt",
        "bash": "friring-cli session signal --state blocked || true",
        "powershell": "friring-cli session signal --state blocked 2>$null; exit 0",
        "timeoutSec": 10
      }
    ],
    "agentStop": [
      {
        "type": "command",
        "bash": "friring-cli session signal --state done || true",
        "powershell": "friring-cli session signal --state done 2>$null; exit 0",
        "timeoutSec": 10
      }
    ]
  }
}
